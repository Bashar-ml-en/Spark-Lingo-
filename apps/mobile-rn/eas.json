{
  "cli": {
    "version": ">=18.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SPARK_LINGO_BUILD_ENV": "development"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "SPARK_LINGO_BUILD_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "SPARK_LINGO_BUILD_ENV": "production"
      }
    }
  }
}

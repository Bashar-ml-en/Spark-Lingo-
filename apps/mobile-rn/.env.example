# This file contains only non-secret development placeholders. Never put a
# service-role, provider, billing, or webhook credential in an EXPO_PUBLIC_* value.
SPARK_LINGO_BUILD_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-a-local-or-staging-publishable-key

# Set only to the literal string "true" in a build that has the matching
# provider and exact callback URL registered in Supabase. OAuth stays hidden
# otherwise. The development callback is sparklingo-development://auth/callback.
EXPO_PUBLIC_GOOGLE_OAUTH_ENABLED=false
EXPO_PUBLIC_APPLE_OAUTH_ENABLED=false

# These are public, current approved legal-notice values. If a URL or version
# is absent or invalid, the corresponding feature stays disabled (fail closed).
# EXPO_PUBLIC_ANALYTICS_NOTICE_URL=
# EXPO_PUBLIC_ANALYTICS_NOTICE_VERSION=
# EXPO_PUBLIC_AI_AND_VOICE_NOTICE_URL=
# EXPO_PUBLIC_AI_AND_VOICE_NOTICE_VERSION=

# Staging and production builds must set all of these in protected build
# environment configuration. They deliberately have no source defaults.
# SPARK_LINGO_IOS_BUNDLE_ID=
# SPARK_LINGO_ANDROID_PACKAGE=
# SPARK_LINGO_URL_SCHEME=

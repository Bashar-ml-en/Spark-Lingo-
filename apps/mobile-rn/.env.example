# This file contains only non-secret development placeholders. Never put a
# service-role, provider, billing, or webhook credential in an EXPO_PUBLIC_* value.
SPARK_LINGO_BUILD_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-a-local-or-staging-publishable-key

# Staging and production builds must set all of these in protected build
# environment configuration. They deliberately have no source defaults.
# SPARK_LINGO_IOS_BUNDLE_ID=
# SPARK_LINGO_ANDROID_PACKAGE=
# SPARK_LINGO_URL_SCHEME=

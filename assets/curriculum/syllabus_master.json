{
  "spanish": {
    "units": [
      {
        "id": "es_unit_1",
        "title": "Basic Survival Kit",
        "description": "Greetings, basic expressions, and essential interactions.",
        "lessons": [
          {
            "id": "es_u1_l1",
            "title": "Greetings & Welcomes",
            "description": "Learn to say Hello, Goodbye, and check how someone is doing.",
            "flashcards": [
              {
                "id": "es_card_1",
                "front": "Hola",
                "back": "Hello",
                "context": "Hola, ¿cómo estás? (Hello, how are you?)"
              },
              {
                "id": "es_card_2",
                "front": "Buenos días",
                "back": "Good morning",
                "context": "Buenos días, mi amigo. (Good morning, my friend.)"
              },
              {
                "id": "es_card_3",
                "front": "Adiós",
                "back": "Goodbye",
                "context": "Adiós, nos vemos mañana. (Goodbye, see you tomorrow.)"
              }
            ]
          },
          {
            "id": "es_u1_l2",
            "title": "Essential Needs",
            "description": "Learn to ask for water, food, and locate the bathroom.",
            "flashcards": [
              {
                "id": "es_card_4",
                "front": "¿Dónde está el baño?",
                "back": "Where is the bathroom?",
                "context": "Disculpe, ¿dónde está el baño? (Excuse me, where is the bathroom?)"
              },
              {
                "id": "es_card_5",
                "front": "Agua, por favor",
                "back": "Water, please",
                "context": "Tengo sed. Agua, por favor. (I am thirsty. Water, please.)"
              }
            ]
          }
        ]
      }
    ]
  },

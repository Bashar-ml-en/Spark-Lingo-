# Local Edge Function development only. Do not commit a populated .env file.
# Hosted Supabase functions receive SUPABASE_URL, SUPABASE_ANON_KEY, and the
# service-role key from the platform; set the values below as hosted secrets.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional emergency server-side AI override. Leave unset to use the database
# runtime control. Any non-empty value other than true/1 disables AI.
# AI_ENABLED=false

# Anonymous Auth users are denied AI by default. Do not enable this exception
# for a shared/staging/production environment until hosted CAPTCHA, WAF, rate
# limits, monitoring, and a security-owner approval have been evidenced.
# ALLOW_ANONYMOUS_AI=false

# Required only when running delete-account locally.
SUPABASE_SERVICE_ROLE_KEY=

# RevenueCat webhook (server-only; leave disabled by default). Do not put any
# production value in this file, a Flutter --dart-define, source control, or a
# device build. Configure all of these as protected hosted function secrets
# after the staging webhook and sandbox-purchase tests have passed.
BILLING_WEBHOOK_ENABLED=false
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ALLOWED_APP_IDS=
REVENUECAT_ALLOWED_ENTITLEMENT_IDS=spark_premium
REVENUECAT_ALLOWED_ENVIRONMENTS=SANDBOX

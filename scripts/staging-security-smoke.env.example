# This is a variable-name template only. Do not put values in this file or
# commit a populated copy. Store values in a protected CI `staging`
# environment. The script has no production fallback and rejects the reviewed
# production project before making a network request.
SPARK_LINGO_TEST_ENV=staging
# Protected GitHub Environment variable, exact value: configured-staging-only
STAGING_ENVIRONMENT_GUARD=
# Manual workflow inputs. The confirmation must be staging:<staging project ref>.
SMOKE_TARGET_CONFIRMATION=
STAGING_CHANGE_REFERENCE=
# Supplied by GitHub Actions from the selected source tag. Do not set these in
# an ad-hoc local shell for a hosted run.
SOURCE_REF_TYPE=tag
SOURCE_REF_NAME=
SOURCE_REF_PROTECTED=true
SUPABASE_TEST_URL=
SUPABASE_TEST_PROJECT_REF=
# Non-secret production identity variables, protected alongside the staging
# variables solely so the guard can prove the target is distinct.
SUPABASE_PRODUCTION_URL=
SUPABASE_PRODUCTION_PROJECT_REF=
SUPABASE_TEST_ANON_KEY=
SMOKE_USER_A_ID=
SMOKE_USER_B_ID=
SMOKE_USER_A_ACCESS_TOKEN=
SMOKE_USER_B_ACCESS_TOKEN=
SMOKE_ANONYMOUS_ACCESS_TOKEN=
# `disabled` is the safe default. Use `enabled` only for a deliberate
# consent-boundary drill with a recoverable test account that has no consent.
SMOKE_EXPECT_AI_RUNTIME=disabled
SMOKE_NO_CONSENT_ACCESS_TOKEN=
